---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/dates';

// All posts that aren't drafts, newest first.
const posts = (await getCollection('reflections', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Reflections">
  <h1>Reflections</h1>
  {posts.length === 0 ? (
    <p class="muted">Nothing here yet.</p>
  ) : (
    <ul class="list">
      {posts.map((post) => (
        <li>
          <h3><a href={`/reflections/${post.id}/`}>{post.data.title}</a></h3>
          <div class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
