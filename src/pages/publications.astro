---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/dates';

// Items come from src/data/publications.yaml, shown newest first.
const items = (await getCollection('publications')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Publications and Projects">
  <h1>Publications and Projects</h1>
  <p class="muted">Reports, articles, data projects, and talks.</p>
  <ul class="list">
    {items.map(({ data }) => (
      <li>
        <h3><a href={data.link}>{data.title}</a></h3>
        <div class="meta">{data.outlet} · <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></div>
        <p>{data.description}</p>
      </li>
    ))}
  </ul>
</Base>
